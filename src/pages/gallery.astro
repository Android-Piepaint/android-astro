---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { Image } from "astro:assets";
import { gallery } from "../data/gallery";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

// Newest first by default; the button on the page can flip the order.
const items = gallery
  .map((item) => ({
    ...item,
    img: modules[`../assets/gallery/${item.file}`]?.default,
  }))
  .filter((item) => item.img)
  .sort((a, b) => b.date.localeCompare(a.date));

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-CA", { timeZone: "UTC" }); // 2026-11-10
---

<MainGridLayout title={i18n(I18nKey.gallery)}>
  <div class="card-base p-6 onload-animation">
    <h1 class="text-3xl font-bold text-90 mb-2" data-gallery-i18n={I18nKey.gallery}>
      {i18n(I18nKey.gallery)}
    </h1>
    <p class="text-50 mb-4" data-gallery-i18n={I18nKey.galleryDescription}>
      {i18n(I18nKey.galleryDescription)}
    </p>

    <div class="mb-6">
      <button
        type="button"
        class="btn-regular rounded-lg px-3 h-9 text-sm"
        data-gallery-sort
        data-order="desc"
        data-key-desc={I18nKey.gallerySortNewest}
        data-key-asc={I18nKey.gallerySortOldest}
        data-label-desc={i18n(I18nKey.gallerySortNewest)}
        data-label-asc={i18n(I18nKey.gallerySortOldest)}
      >
        {i18n(I18nKey.gallerySortNewest)}
      </button>
    </div>

    <div class="gallery-wall">
      {items.map((item) => (
        <figure class="gallery-item" data-date={item.date}>
          <a href={item.img.src} data-gallery>
            <Image src={item.img} alt={item.caption} width={700} loading="lazy" />
          </a>
          <figcaption>
            <time datetime={item.date} class="text-50">{fmt(item.date)}</time>
            <span class="text-75">{item.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</MainGridLayout>

<style>
  .gallery-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
    display: block;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.25rem 0;
    font-size: 0.875rem;
  }
  figcaption time {
    font-size: 0.75rem;
  }
</style>

<script>
  import type I18nKeyType from "../i18n/i18nKey";
  import { getTranslation } from "../i18n/translation";
  import { getSavedLang } from "../utils/site-lang";

  type Key = I18nKeyType;

  // Label for the sort button in the current order and language.
  function sortLabel(btn: HTMLButtonElement): string {
    const asc = btn.dataset.order === "asc";
    const saved = getSavedLang();
    if (saved) {
      const key = (asc ? btn.dataset.keyAsc : btn.dataset.keyDesc) as Key;
      const text = getTranslation(saved)[key];
      if (text) return text;
    }
    return (asc ? btn.dataset.labelAsc : btn.dataset.labelDesc) ?? "";
  }

  // Re-translate the gallery's own text in the browser.
  function applyGalleryLang(lang: string) {
    const t = getTranslation(lang);
    document
      .querySelectorAll<HTMLElement>("[data-gallery-i18n]")
      .forEach((el) => {
        const text = t[el.dataset.galleryI18n as Key];
        if (text) el.textContent = text;
      });
    const btn = document.querySelector<HTMLButtonElement>("[data-gallery-sort]");
    if (btn) btn.textContent = sortLabel(btn);
  }

  function applySaved() {
    const saved = getSavedLang();
    if (saved) applyGalleryLang(saved);
  }

  const w = window as any;
  if (!w.__galleryBound) {
    w.__galleryBound = true;

    // One delegated click handler: survives Swup page swaps.
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // Language picker: follow the language the reader just chose.
      const langLink = target.closest<HTMLElement>("#lang-list-panel a[data-lang]");
      if (langLink?.dataset.lang) {
        applyGalleryLang(langLink.dataset.lang);
        return;
      }

      // Sort toggle.
      const btn = target.closest<HTMLButtonElement>("[data-gallery-sort]");
      if (!btn) return;
      const wall = document.querySelector<HTMLElement>(".gallery-wall");
      if (!wall) return;

      const next = btn.dataset.order === "desc" ? "asc" : "desc";
      btn.dataset.order = next;
      btn.textContent = sortLabel(btn);

      const figs = Array.from(wall.children) as HTMLElement[];
      figs.sort((a, b) => {
        const c = (a.dataset.date ?? "").localeCompare(b.dataset.date ?? "");
        return next === "asc" ? c : -c;
      });
      figs.forEach((f) => wall.appendChild(f));
    });

    // Re-apply the saved language after every Swup content swap.
    const hook = () => w.swup.hooks.on("content:replace", applySaved);
    if (w.swup) hook();
    else document.addEventListener("swup:enable", hook);
  }

  // Apply the saved language when the page (or this script) loads.
  applySaved();
</script>